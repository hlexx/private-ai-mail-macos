	<!--
	NOTE — `SUEnableDownloaderService` / `SUEnableInstallerLauncherService`
	intentionally NOT set. Both opt the app into Sparkle XPC helpers that
	are only useful when the app is sandboxed. We ship the SPM distribution
	of Sparkle (no `InstallerLauncher.xpc` bundled) and have disabled the
	sandbox for alpha builds (see PrivateAIMail.entitlements). With those
	keys absent, Sparkle uses the default installer flow which works for
	an unsandboxed app and does not need the missing XPC services.
	-->
	<key>SUFeedURL</key>
	<string>https://github.com/hlexx/private-ai-mail-macos/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>OOaOvUsCEZZc7TYU0tepl2qo9fpYXO/PhuiW1Odn3pw=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
